{
  "name": "apex-demo-server",
  "version": "1.0.0",
  "description": "Apex International College Management System API Server",
  "main": "./dist/src/app.js",
  "scripts": {
    "dev": "tsx watch ./src/app.ts",
    "seed:demo": "tsx ./src/db/seedDemo.ts",
    "build": "tsc",
    "start": "node ./dist/src/app.js",
    "start:prod": "node ./dist/src/app.js",
    "start:dev": "tsx watch ./src/app.ts",
    "seed-permissions": "tsx ./src/db/seed.ts seed-permissions",
    "seed-super-admin": "tsx ./src/db/seedSuperAdmin.ts seed-super-admin",
    "seed-grade-scales": "tsx ./src/db/seedGradeScale.ts seed-grade-scales",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --ignore-path .gitignore --write \"./src/**/*.+(js|ts|json)\"",
    "prettier:fix": "prettier --write src",
    "prisma:migrate": "npx prisma migrate dev && npx prisma generate",
    "regression:student-routine": "tsx ./scripts/regression/student-class-routine-promotion.ts"
  },
  "author": "Universal",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.8.0",
    "@types/pg": "^8.23.1",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.1",
    "pg": "^8.23.1",
    "sharp": "^0.34.4",
    "zod": "^3.25.30"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.21",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.27.0",
    "prettier": "^3.5.3",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
