  updated_at       DateTime @updatedAt

  @@map("staff_resignations")
}

// ─────────────────────────────────────────────────────────────────────────────
// EXAM
// ─────────────────────────────────────────────────────────────────────────────

model ExamConfig {
  id                String         @id @default(uuid())
  academic_class_id String
  academicClass     AcademicClass  @relation(fields: [academic_class_id], references: [id], onDelete: Cascade)
  program_id        String?
  program           Program?       @relation(fields: [program_id], references: [id], onDelete: Cascade)
  department_id     String?
  department        Department?    @relation(fields: [department_id], references: [id], onDelete: Cascade)
  group             String?
  batch_id          String?
  batch             Batch?         @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  section_id        String?
  section           AcademicSection? @relation(fields: [section_id], references: [id], onDelete: SetNull)
  // SHA-256 of the duplicate-check key (normalized name, program, department,
  // class, group, batch, section, Dhaka day). Fixed-size race backstop: the
  // identifying columns exceed MySQL's 3072-byte index limit, so they cannot
  // sit in one UNIQUE index directly. The service check stays authoritative.
  dedupe_key        String?          @unique
  exam_name         String
  exam_date         DateTime
  is_published      Boolean        @default(false)
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt
  examSchedules     ExamSchedule[]
  admitCardLogs     AdmitCardLog[]

  @@map("exam_configs")
}

model ExamSchedule {
  id                 String              @id @default(uuid())
  examConfigId       String
  examConfig         ExamConfig          @relation(fields: [examConfigId], references: [id], onDelete: Cascade)
  program_id         String?
  program            Program?            @relation(fields: [program_id], references: [id], onDelete: Cascade)
  department_id      String?
  department         Department?         @relation(fields: [department_id], references: [id], onDelete: Cascade)
  year               Int?
  subjectId          String
  subject            Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examTakenYear      Int?
  examDate           DateTime
  startTime          DateTime
  endTime            DateTime
  durationMinutes    Int
  fullMarks          Float
  passMarks          Float
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  studentExamResults StudentExamResult[]

  @@map("exam_schedules")
}

model GradeSystem {
  id                 String              @id @default(uuid())
  grade_name         String
  grade_point        Float
  mark_from          Float
  mark_to            Float
  remark             String?
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  studentExamResults StudentExamResult[]

  @@map("grade_systems")
}

// ─────────────────────────────────────────────────────────────────────────────
// GRADE SCALE (new, percentage-based, institution-scoped)
// Replaces hardcoded/legacy grade branching; GradeSystem is kept as legacy and
// flagged for migration/backfill (do NOT drop its columns until decided).
// ─────────────────────────────────────────────────────────────────────────────
model GradeScale {
  id            String   @id @default(uuid())
  minPercent    Float
  maxPercent    Float
  letterGrade   String
  gradePoint    Float
  institutionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("grade_scales")
}

model StudentExamResult {
  id               String       @id @default(uuid())
  student_id       String
  student          Student      @relation(fields: [student_id], references: [id], onDelete: Cascade)
  exam_schedule_id String
  examSchedule     ExamSchedule @relation(fields: [exam_schedule_id], references: [id], onDelete: Cascade)
  obtained_marks   Float
  grade_id         String
  grade            GradeSystem  @relation(fields: [grade_id], references: [id], onDelete: Cascade)
  letterGrade      String?      @db.VarChar(10)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  @@unique([student_id, exam_schedule_id])
  @@map("student_exam_results")
}

// ─────────────────────────────────────────────────────────────────────────────
// CLASS ROUTINE
// ─────────────────────────────────────────────────────────────────────────────

model ClassRoutine {
  id                  String             @id @default(uuid())
  academic_class_id   String
  academicClass       AcademicClass      @relation(fields: [academic_class_id], references: [id], onDelete: Cascade)
  academic_section_id String?
  academicSection     AcademicSection?   @relation(fields: [academic_section_id], references: [id], onDelete: Cascade)
  batch_id            String?
  batch               Batch?             @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  shift_id            String?
  shift               Shift?             @relation(fields: [shift_id], references: [id], onDelete: Cascade)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  classRoutineItems   ClassRoutineItem[]

  @@map("class_routines")
}

model ClassRoutineItem {
  id               String       @id @default(uuid())
  class_routine_id String
  classRoutine     ClassRoutine @relation(fields: [class_routine_id], references: [id], onDelete: Cascade)
  period_no        Int
  day              DayOfWeek
  subject_id       String
  subject          Subject      @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  teacher_id       String
  teacher          Teacher      @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  // Optional room/lab for THIS slot only - the same class can use a different
  // room on another day or period, so it belongs on the item and not on
  // ClassRoutine. Existing rows stay NULL ("not set").
  roomNo           String?      @db.VarChar(20)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  @@unique([class_routine_id, period_no, day])
  @@map("class_routine_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// PERIOD SETTINGS
// ─────────────────────────────────────────────────────────────────────────────

model PeriodSetting {
  id           String   @id @default(uuid())
  period_count Int      @default(6)
  periods      Json?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("period_settings")
}

