// Complaint Management
// ─────────────────────────────────────────────────────────────────────────────
model Complaint {
  id          String          @id @default(uuid())
  reason      String
  description String          @db.Text
  status      ComplaintStatus @default(PENDING)

  complainantType PersonType
  accusedType     PersonType

  complainantStudentId String?
  complainantStudent   Student? @relation("ComplaintsFiledAsStudent", fields: [complainantStudentId], references: [id], onDelete: SetNull)
  complainantTeacherId String?
  complainantTeacher   Teacher? @relation("ComplaintsFiledAsTeacher", fields: [complainantTeacherId], references: [id], onDelete: SetNull)
  complainantStaffId   String?
  complainantStaff     Staff?   @relation("ComplaintsFiledAsStaff", fields: [complainantStaffId], references: [id], onDelete: SetNull)

  accusedStudentId String?
  accusedStudent   Student? @relation("ComplaintsAgainstStudent", fields: [accusedStudentId], references: [id], onDelete: SetNull)
  accusedTeacherId String?
  accusedTeacher   Teacher? @relation("ComplaintsAgainstTeacher", fields: [accusedTeacherId], references: [id], onDelete: SetNull)
  accusedStaffId   String?
  accusedStaff     Staff?   @relation("ComplaintsAgainstStaff", fields: [accusedStaffId], references: [id], onDelete: SetNull)

  department_id   String?
  department      Department?      @relation(fields: [department_id], references: [id], onDelete: SetNull)
  class_id        String?
  academicClass   AcademicClass?   @relation(fields: [class_id], references: [id], onDelete: SetNull)
  section_id      String?
  academicSection AcademicSection? @relation(fields: [section_id], references: [id], onDelete: SetNull)
  roll            String?          @db.VarChar(20)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("complaints")
}

