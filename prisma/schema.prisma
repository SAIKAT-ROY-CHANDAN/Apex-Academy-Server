// ─────────────────────────────────────────────────────────────────────────────
// Hostel Management 
// ─────────────────────────────────────────────────────────────────────────────

model HostelConfiguration {
  id            String        @id @default(uuid())
  building_name String
  total_floors  Int
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  hostelFloors  HostelFloor[]

  @@map("hostel_configurations")
}

model HostelFloor {
  id                      String              @id @default(uuid())
  hostel_floor_number     Int
  hostel_total_rooms      Int
  hostel_configuration_id String
  hostelConfiguration     HostelConfiguration @relation(fields: [hostel_configuration_id], references: [id], onDelete: Cascade)
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt
  hostelRooms             HostelRoom[]

  @@map("hostel_floors")
}

model HostelRoom {
  id                 String             @id @default(uuid())
  hostel_room_number String
  available_sits     Int
  hostel_floor_id    String
  hostelFloor        HostelFloor        @relation(fields: [hostel_floor_id], references: [id], onDelete: Cascade)
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt
  hostelAllocations  HostelAllocation[]

  @@map("hostel_rooms")
}

// HOSTEL ALLOCATION

enum HostelAllocationStatus {
  ACTIVE
  RELOCATED
  CHECKED_OUT
}

model HostelAllocation {
  id             String                 @id @default(uuid())
  student_id     String
  student        Student                @relation(fields: [student_id], references: [id], onDelete: Cascade)
  hostel_room_id String
  hostelRoom     HostelRoom             @relation(fields: [hostel_room_id], references: [id], onDelete: Cascade)
  sit            String?                @db.VarChar(10)
  allocated_at   DateTime               @default(now())
  released_at    DateTime?
  status         HostelAllocationStatus @default(ACTIVE)
  created_at     DateTime               @default(now())
  updated_at     DateTime               @updatedAt

  @@index([student_id])
  @@index([hostel_room_id])
  @@index([status])
  @@map("hostel_allocations")
}

// HOSTEL FEE COLLECTION
model HostelFeeCollection {
  id                       String                    @id @default(uuid())
  student_id               String
  student                  Student                   @relation(fields: [student_id], references: [id], onDelete: Cascade)
  collection_date          DateTime
  total_amount             Float
  scholarship_amount       Float                     @default(0)
  paid_amount              Float
  due_amount               Float
  payment_method           PaymentMethod?
  transaction_id           String?                   @unique
  bkash_sender_number      String?                   @db.VarChar(20)
  bkash_receiver_number    String?                   @db.VarChar(20)
  payment_note             String?
  created_at               DateTime                  @default(now())
  updated_at               DateTime                  @updatedAt
  hostelFeeCollectionItems HostelFeeCollectionItem[]
  mealCollection           MealCollection?
  hostelInvoice            HostelInvoice?

  @@map("hostel_fee_collections")
}

model HostelFeeCollectionItem {
  id                       String              @id @default(uuid())
  hostel_fee_collection_id String
  hostelFeeCollection      HostelFeeCollection @relation(fields: [hostel_fee_collection_id], references: [id], onDelete: Cascade)
  item_name                String
  item_amount              Float
  created_at               DateTime            @default(now())
  updated_at               DateTime            @updatedAt

  @@map("hostel_fee_collection_items")
}

model MealCollection {
  id                       String              @id @default(uuid())
  meal_count               Int
  meal_rate                Float
  total_amount             Float
  hostel_fee_collection_id String              @unique
  hostelFeeCollection      HostelFeeCollection @relation(fields: [hostel_fee_collection_id], references: [id], onDelete: Cascade)
  created_at               DateTime            @default(now())
  updated_at               DateTime            @updatedAt

  @@map("meal_collections")
}

// HOSTEL INVOICE — immutable snapshot generated with every fee collection.
// Preserves issue date, due date and the due amount as it was at generation
// time (HostelFeeCollection.due_amount is zeroed on later settlements, this is not).
model HostelInvoice {
  id                       String              @id @default(uuid())
  invoice_no               String              @unique @db.VarChar(40)
  student_id               String
  student                  Student             @relation(fields: [student_id], references: [id], onDelete: Cascade)
  hostel_fee_collection_id String              @unique
  hostelFeeCollection      HostelFeeCollection @relation(fields: [hostel_fee_collection_id], references: [id], onDelete: Cascade)
  issue_date               DateTime
  due_date                 DateTime
  total_amount             Float
  scholarship_amount       Float               @default(0)
  paid_amount              Float
  due_amount               Float
  status                   HostelInvoiceStatus
  created_at               DateTime            @default(now())
  updated_at               DateTime            @updatedAt

  @@index([student_id])
  @@map("hostel_invoices")
}

// HOSTEL EXPENSES

model HostelExpense {
  id                 String              @id @default(uuid())
  expense_date       DateTime
  total_amount       Float
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  hostelExpenseItems HostelExpenseItem[]

