generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "workerd"
}


datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum InstitutionType {
  SCHOOL
  COLLEGE_UNIVERSITY
}

enum SystemModule {
  ACADEMICS
  PAYROLL
  FINANCE
  HOSTEL
  // QUARTER
  // TRANSPORT
  // LIBRARY
  // COMPLAINT
  WEBSITE
}

enum StudentGroup {
  SCIENCE
  COMMERCE
  HUMANITIES
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Religion {
  ISLAM
  HINDU
  CHRISTIAN
  BUDDHIST
  OTHER
}

enum HolidayType {
  PUBLIC
  ACADEMIC
  INSTITUTIONAL
  EMERGENCY
}

enum FeeItemType {
  Monthly
  OneTime
}

enum GenerateType {
  GIVEN
  KEPT
}

enum AcademicQualification {
  SSC
  HSC
  HONORS
  DEGREE_PASS
  DIPLOMA
  MASTERS
  PHD
}

enum TeacherType {
  PERMANENT
  REGULAR
  ADHOC
  GUEST
  PROVISIONAL
  SUBSTITUTE
  PART_TIME
  OTHERS
}

enum AdministrativePosition {
  PRINCIPAL
  VICE_PRINCIPAL
  HEAD_OF_DEPARTMENT
  ASSISTANT_HEAD_OF_DEPARTMENT
  DEAN
  ASSISTANT_DEAN
  COORDINATOR
  DIRECTOR
  NONE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum LeaveType {
  LEAVE_WITHOUT_PAY
  SICK
  PAID_TIME_OFF
  CASUAL
  EARNED
  COMPENSATORY_OFF
  LOSS_OF_PAY
  MATERNITY
  ANNUAL
  SICK_LEAVE
  DOCTORS_APPOINTMENT
  MENTAL_HEALTH_LEAVE
  FAMILY_FUNCTION
  EMERGENCY_LEAVE
  TRAVEL_VACATION
  EXAM_PREPARATION_LEAVE
  INTERNSHIP_PROJECT_WORK
  RELIGIOUS_FESTIVALS
  PERSONAL_REASONS
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StaffType {
  REGULAR
  CONTRACTUAL
  PARTTIME
  OTHERS
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum AdmitCardStatus {
  GIVEN
  PENDING
}

// ── Complaint Enums ─────────────────────────────────────────────────────────────
enum PersonType {
  STUDENT
  TEACHER
  STAFF
}

enum ComplaintStatus {
  PENDING
  ACTION_TAKEN
  REJECTED
}

enum Month {
  JANUARY
  FEBRUARY
  MARCH
  APRIL
  MAY
  JUNE
  JULY
  AUGUST
  SEPTEMBER
  OCTOBER
  NOVEMBER
  DECEMBER
}

// ── Payroll Enums ─────────────────────────────────────────────────────────────

enum PaymentMethod {
  CASH // Manual cash payment
  BANK // Manual bank transfer
  BKASH // Deprecated - kept for existing data
}

enum PayrollStatus {
  PENDING // Not yet paid
  PAID // Fully paid
  PARTIAL // Partially paid (edge case)
}

enum AdvanceStatus {
  ACTIVE // Deduction still in progress
  COMPLETED // Fully recovered from salary
  CANCELLED // Advance was cancelled
}

enum HostelInvoiceStatus {
  PAID // Fully settled at generation time
  PARTIAL // Some amount paid, some due
  UNPAID // Nothing paid at generation time
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  WITH_BACKLOG
  REPEATED
}

enum EnrollmentType {
  REGULAR
  REPEAT
  SUPPLEMENTARY
}

enum Fee_Assign_FOR {
  REGULAR
  SUPPLEMENTARY
}

// ─────────────────────────────────────────────────────────────────────────────
// ADMIN & RBAC
// ─────────────────────────────────────────────────────────────────────────────

model Administrator {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  password        String
  avatar          String?          @db.Text
  is_active       Boolean          @default(true)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  userRole        UserRole?
  payrollPayments PayrollPayment[]
  salaryAdvances  SalaryAdvance[]

  @@map("administrators")
}

model Role {
  id              String           @id @default(uuid())
  role_name       String           @db.VarChar(100)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model UserRole {
  id         String        @id @default(uuid())
  userId     String        @unique
  user       Administrator @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt

  @@map("user_roles")
}

model Permission {
  id              String           @id @default(uuid())
  permission      String           @unique @db.VarChar(100)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt

  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────────────────────────
// FEE STRUCTURE
// ─────────────────────────────────────────────────────────────────────────────

model FeeType {
  id                    String                 @id @default(uuid())
  name                  String
  class_id              String
  academicClass         AcademicClass          @relation(fields: [class_id], references: [id], onDelete: Cascade)
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  feeItems              FeeItem[]
  studentFeeCollections StudentFeeCollection[]

  @@map("fee_types")
}

model FeeItem {
  id                        String                     @id @default(uuid())
  fee_type_id               String
  feeType                   FeeType                    @relation(fields: [fee_type_id], references: [id], onDelete: Cascade)
  name                      String
  FeeItemType               FeeItemType
  isFine                    Boolean                    @default(false)
  payment_start_date        Int?
  last_payment_date         Int?
  fee_assign_for            Fee_Assign_FOR @default(REGULAR)
  amount_every_subject      Float?
  everydayFine_amount       Float?
  amount                    Float
  feeStartMonth             Month?
  feeEndMonth               Month?
  created_at                DateTime                   @default(now())
  updated_at                DateTime                   @updatedAt
  studentFees               StudentFee[]
  studentFeeCollectionItems StudentFeeCollectionItem[]
  membershipFeeCollections  MembershipFeeCollection[]
  libraryDeposits           LibraryDeposit[]

  @@map("fee_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// SHIFT
// ─────────────────────────────────────────────────────────────────────────────

model Shift {
  id                 String              @id @default(uuid())
  name               String
  start_time         DateTime
  end_time           DateTime
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  studentEnrollments StudentEnrollment[]
  teachers           Teacher[]
  classRoutines      ClassRoutine[]

  @@map("shifts")
}

// ─────────────────────────────────────────────────────────────────────────────
// INSTITUTION CONFIG
// ─────────────────────────────────────────────────────────────────────────────

model InstitutionConfig {
  id                 String            @id @default(uuid())
  mode               InstitutionType
  address            String?           @db.Text
  phone              String?           @db.VarChar(20)
  email              String?           @unique
  name               String
  is_setup_completed Boolean           @default(false)
  weekend_days       Json?
  logo               String?           @db.Text
  login_background   String?           @db.Text
  color_scheme       String            @default("#317bff")
  active_modules     Json?             @default("[\"ACADEMICS\"]")
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  academicSessions   AcademicSession[]
  departments        Department[]
  programs           Program[]

  @@map("institution_config")
}

// ─────────────────────────────────────────────────────────────────────────────
// DESIGNATION & SALARY CONFIGURATION
// ─────────────────────────────────────────────────────────────────────────────

model Designation {
  id         String    @id @default(uuid())
  name       String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  teachers   Teacher[]
  staffs     Staff[]

  @@map("designations")
}

model Salary {
  id             String         @id @default(uuid())
  total_amount   Float          @default(0)
  teacher_id     String?        @unique
  teacher        Teacher?       @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  staff_id       String?        @unique
  staff          Staff?         @relation(fields: [staff_id], references: [id], onDelete: Cascade)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  customSalaries CustomSalary[]

  @@map("salaries")
}

model CustomSalary {
  id               String   @id @default(uuid())
  salary_id        String
  salary           Salary   @relation(fields: [salary_id], references: [id], onDelete: Cascade)
  salary_component String
  salary_amount    Float
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("custom_salaries")
}

model OvertimeTeacherConfig {
  id                     String            @id @default(uuid())
  teacher_id             String            @unique
  teacher                Teacher           @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  overtime_hourly_amount Float
  created_at             DateTime          @default(now())
  updated_at             DateTime          @updatedAt
  teacherOvertimes       TeacherOvertime[]

  @@map("overtimes")
}

model OvertimeStaffConfig {
  id                     String          @id @default(uuid())
  staff_id               String
  staff                  Staff           @relation(fields: [staff_id], references: [id], onDelete: Cascade)
  overtime_hourly_amount Float
  created_at             DateTime        @default(now())
  updated_at             DateTime        @updatedAt
  staffOvertimes         StaffOvertime[]

  @@map("overtimes_staff")
}

// ─────────────────────────────────────────────────────────────────────────────
// ACADEMIC SESSION
// ─────────────────────────────────────────────────────────────────────────────

model AcademicSession {
  id                 String              @id @default(uuid())
  institution_id     String
  institution        InstitutionConfig   @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  session_name       String
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  studentEnrollments StudentEnrollment[]

  @@map("academic_sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// PROGRAM & DEPARTMENT (College / University only)
// ─────────────────────────────────────────────────────────────────────────────

model Program {
  id              String            @id @default(uuid())
  institution_id  String
  institution     InstitutionConfig @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  program_name    String
  duration_years  Int?
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  departments     Department[]
  academicClasses AcademicClass[]
  examConfigs     ExamConfig[]
  examSchedules   ExamSchedule[]

  @@map("programs")
}

model Department {
  id              String            @id @default(uuid())
  institution_id  String
  institution     InstitutionConfig @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  department_name String
  program_id      String
  program         Program           @relation(fields: [program_id], references: [id], onDelete: Cascade)
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  academicClasses AcademicClass[]
  teachers        Teacher[]
  complaints      Complaint[]
  examConfigs     ExamConfig[]
  examSchedules   ExamSchedule[]

  @@map("departments")
}

// ─────────────────────────────────────────────────────────────────────────────
// ACADEMIC STRUCTURE
// ─────────────────────────────────────────────────────────────────────────────

model AcademicClass {
  id                    String                 @id @default(uuid())
  program_id            String?
  program               Program?               @relation(fields: [program_id], references: [id], onDelete: Cascade)
  department_id         String?
  department            Department?            @relation(fields: [department_id], references: [id], onDelete: Cascade)
  class_name            String
  class_level           Int?
  year_level            Int?
  group                 StudentGroup?
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  academicSections      AcademicSection[]
  academicClassSubjects AcademicClassSubject[]
  studentEnrollments    StudentEnrollment[]
  examConfigs           ExamConfig[]
  classRoutines         ClassRoutine[]
  complaints            Complaint[]
  studentAttendances    StudentAttendance[]
  subjects              Subject[]
  feeTypes              FeeType[]
  homework              Homework[]

  @@map("academic_classes") // Fixed: was missing @@map
}

model AcademicSection {
  id                 String              @id @default(uuid())
  section_name       String
  class_id           String
  academicClass      AcademicClass       @relation(fields: [class_id], references: [id], onDelete: Cascade)
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  studentEnrollments StudentEnrollment[]
  classRoutines      ClassRoutine[]
  complaints         Complaint[]
  homework           Homework[]
  examConfigs        ExamConfig[]

  @@map("academic_sections")
}

model Subject {
  id                    String                 @id @default(uuid())
  name                  String
  class_id              String
  academicClass         AcademicClass          @relation(fields: [class_id], references: [id], onDelete: Cascade)
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  academicClassSubjects AcademicClassSubject[]
  teachers              Teacher[]
  examSchedules         ExamSchedule[]
  classRoutineItems     ClassRoutineItem[]
  homework              Homework[]
  studentAttendances    StudentAttendance[]

  @@map("subjects")
}

// not used 
model AcademicClassSubject {
  id            String        @id @default(uuid())
  class_id      String
  academicClass AcademicClass @relation(fields: [class_id], references: [id], onDelete: Cascade)
  subject_id    String
  subject       Subject       @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  @@unique([class_id, subject_id])
  @@map("academic_class_subjects")
}

model Batch {
  id                 String              @id @default(uuid())
  batch_name         String
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  studentEnrollments StudentEnrollment[]
  examConfigs        ExamConfig[]
  classRoutines      ClassRoutine[]

  @@map("batches")
}

// ─────────────────────────────────────────────────────────────────────────────
// STUDENT
// ─────────────────────────────────────────────────────────────────────────────

enum StudentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Student {
  id                    String                 @id @default(uuid())
  name                  String
  status                StudentStatus          @default(PENDING)
  father_name           String
  mother_name           String
  religion              Religion?
  is_residential        Boolean                @default(false)
  nid_no                String?                @unique
  gender                Gender
  student_phone         String?                @unique @db.VarChar(20)
  father_phone          String                 @db.VarChar(20)
  mother_phone          String?                @db.VarChar(20)
  photo                 String?                @db.Text
  village_road          String?                @db.Text
  post_office           String?                @db.Text
  sub_district          String                 @db.Text
  district              String                 @db.Text
  email                 String?                @unique
  password              String                 @db.VarChar(255)
  is_active             Boolean                @default(true)
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  studentEnrollments    StudentEnrollment[]
  idCardGenerateLogs    IDCardGenerateLog[]
  studentFeeCollections StudentFeeCollection[]
  studentExamResults    StudentExamResult[]
  admitCardLogs         AdmitCardLog[]
  hostelAllocations     HostelAllocation[]
  hostelFeeCollections  HostelFeeCollection[]
  hostelInvoices        HostelInvoice[]
  studentLibraryMembers StudentLibraryMember[]
  complaintsFiled       Complaint[]            @relation("ComplaintsFiledAsStudent")
  complaintsAgainst     Complaint[]            @relation("ComplaintsAgainstStudent")
  studentAttendances    StudentAttendance[]
  studentLeaveRequests  StudentLeaveRequest[]

  @@map("students")
}

model StudentEnrollment {
  id                  String           @id @default(uuid())
  student_id          String
  student             Student          @relation(fields: [student_id], references: [id], onDelete: Cascade)
  academic_session_id String
  academicSession     AcademicSession  @relation(fields: [academic_session_id], references: [id], onDelete: Cascade)
  academic_class_id   String
  academicClass       AcademicClass    @relation(fields: [academic_class_id], references: [id], onDelete: Cascade)
  academic_section_id String?
  academicSection     AcademicSection? @relation(fields: [academic_section_id], references: [id], onDelete: Cascade)
  batch_id            String
  batch               Batch            @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  shift_id            String?
  shift               Shift?           @relation(fields: [shift_id], references: [id], onDelete: Cascade)
  roll_number         String?          @db.VarChar(20)
  registration_number String?          @db.VarChar(20)
  merit_position      Int?
  enrollment_status   EnrollmentStatus @default(ACTIVE)
  enrollment_type     EnrollmentType   @default(REGULAR)
  subject_fail_count  Int              @default(0)
  is_primary          Boolean          @default(true)
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt
  studentFees         StudentFee[]
  studentFeeCollectionItems StudentFeeCollectionItem[]

  @@map("student_enrollments")
}

// ─────────────────────────────────────────────────────────────────────────────
// STUDENT FEE COLLECTION
// ─────────────────────────────────────────────────────────────────────────────

model StudentFee {
  id                    String            @id @default(uuid())
  student_enrollment_id String
  studentEnrollment     StudentEnrollment @relation(fields: [student_enrollment_id], references: [id], onDelete: Cascade)
  scholarship_amount    Float             @default(0)
  due_amount            Float             @default(0)
  paid_amount           Float             @default(0)
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt
  feeItem               FeeItem?          @relation(fields: [feeItemId], references: [id])
  feeItemId             String?

  @@unique([student_enrollment_id])
  @@map("student_fees")
}

model StudentFeeCollection {
  id                        String                     @id @default(uuid())
  fee_type_id               String
  feeType                   FeeType                    @relation(fields: [fee_type_id], references: [id], onDelete: Cascade)
  student_id                String
  student                   Student                    @relation(fields: [student_id], references: [id], onDelete: Cascade)
  created_at                DateTime                   @default(now())
  updated_at                DateTime                   @updatedAt
  studentFeeCollectionItems StudentFeeCollectionItem[]

  @@map("student_fee_collections")
}

model StudentFeeCollectionItem {
  id                        String               @id @default(uuid())
  student_fee_collection_id String
  studentFeeCollection      StudentFeeCollection @relation(fields: [student_fee_collection_id], references: [id], onDelete: Cascade)
  fee_item_id               String
  feeItem                   FeeItem              @relation(fields: [fee_item_id], references: [id], onDelete: Cascade)
  student_enrollment_id     String?
  studentEnrollment         StudentEnrollment?   @relation(fields: [student_enrollment_id], references: [id], onDelete: SetNull)
  fee_month                 Month? // Which billing month this payment is for (null for OneTime items)
  fee_year                  Int? // Which billing year (e.g. 2026, 2027) (null for OneTime items)
  discount_amount           Float                @default(0)
  paid_amount               Float                @default(0)
  line_total_amount         Float                @default(0)
  fine_amount               Float                @default(0)
  created_at                DateTime             @default(now())
  updated_at                DateTime             @updatedAt
  collectionInfos           CollectionInfo[]

  @@unique([student_fee_collection_id, fee_item_id])
  @@map("student_fee_collection_items")
}

model CollectionInfo {
  id                             String                   @id @default(uuid())
  student_fee_collection_item_id String
  studentFeeCollectionItem       StudentFeeCollectionItem @relation(fields: [student_fee_collection_item_id], references: [id], onDelete: Cascade)
  payment_method                 PaymentMethod
  payment_note                   String?                  @db.VarChar(100)
  paid_amount                    Float                    @default(0)
  collectedBy                    String                   @db.VarChar(100)
  created_at                     DateTime                 @default(now())
  updated_at                     DateTime                 @updatedAt

  @@map("collection_infos")
}

model StudentAttendance {
  id                String           @id @default(uuid())
  student_id        String
  student           Student          @relation(fields: [student_id], references: [id], onDelete: Cascade)
  teacher_id        String
  teacher           Teacher          @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  attendance_status AttendanceStatus
  attendance_date   DateTime
  subject_id        String?
  subject           Subject?         @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  group             StudentGroup?
  academic_class_id String?
  academicClass     AcademicClass?   @relation(fields: [academic_class_id], references: [id], onDelete: Cascade)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  @@map("student_attendances")
}

// ─────────────────────────────────────────────────────────────────────────────
// HOLIDAY
// ─────────────────────────────────────────────────────────────────────────────

model Holiday {
  id           String      @id @default(uuid())
  title        String
  description  String?     @db.Text
  start_date   DateTime
  end_date     DateTime?
  holiday_type HolidayType
  is_active    Boolean     @default(true)
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  @@map("holidays")
}

// ─────────────────────────────────────────────────────────────────────────────
// ID CARD
// ─────────────────────────────────────────────────────────────────────────────

model IDCardGenerateLog {
  id            String       @id @default(uuid())
  student_id    String
  student       Student      @relation(fields: [student_id], references: [id], onDelete: Cascade)
  generated_at  DateTime     @default(now())
  generate_type GenerateType
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  @@map("id_card_generate_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// TEACHER
// ─────────────────────────────────────────────────────────────────────────────

model Teacher {
  id                                 String                 @id @default(uuid())
  full_name                          String
  email                              String?                @unique
  phone                              String                 @db.VarChar(20)
  bkash_number                       String?                @db.VarChar(20)
  address                            String?                @db.Text
  password                           String                 @db.VarChar(255)
  photo                              String?                @db.Text
  gender                             Gender
  last_qualification                 AcademicQualification
  academic_document                  String                 @db.Text
  previous_institution_resign_letter String?                @db.Text
  nid_front                          String?                @db.Text
  nid_back                           String?                @db.Text
  isResigned                         Boolean                @default(false)
  is_active                          Boolean                @default(true)
  shift_id                           String?
  shift                              Shift?                 @relation(fields: [shift_id], references: [id], onDelete: Cascade)
  department_id                      String?
  department                         Department?            @relation(fields: [department_id], references: [id], onDelete: Cascade)
  subject_id                         String?
  subject                            Subject?               @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  teacher_type                       TeacherType
  administrative_position            AdministrativePosition?
  designation_id                     String
  designation                        Designation            @relation(fields: [designation_id], references: [id], onDelete: Cascade)
  created_at                         DateTime               @default(now())
  updated_at                         DateTime               @updatedAt
  teacherAttendances                 TeacherAttendance[]
  teacherLeaveRequests               TeacherLeaveRequest[]
  classRoutineItems                  ClassRoutineItem[]
  teacherPayrolls                    TeacherPayroll[]
  salaryAdvances                     SalaryAdvance[]
  quarterAllocations                 QuarterAllocation[]
  complaintsFiled                    Complaint[]            @relation("ComplaintsFiledAsTeacher")
  complaintsAgainst                  Complaint[]            @relation("ComplaintsAgainstTeacher")
  feedbackForms                      FeedbackForm[]
  salary                             Salary?
  teacherOvertimes                   TeacherOvertime[]
  overtimeTeacherConfig              OvertimeTeacherConfig?
  teacherResignation                 TeacherResignation?
  homework                           Homework[]
  studentAttendances                 StudentAttendance[]

  @@map("teachers")
}

model TeacherAttendance {
  id                String           @id @default(uuid())
  teacher_id        String
