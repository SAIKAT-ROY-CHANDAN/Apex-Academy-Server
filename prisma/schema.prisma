// ─────────────────────────────────────────────────────────────────────────────
// PAYROLL SYSTEM
// ─────────────────────────────────────────────────────────────────────────────

model PayrollCycle {
  id           String   @id @default(uuid())
  month        Int
  year         Int
  is_finalized Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  teacherPayrolls TeacherPayroll[]
  staffPayrolls   StaffPayroll[]

  @@unique([month, year])
  @@map("payroll_cycles")
}

model TeacherPayroll {
  id               String       @id @default(uuid())
  payroll_cycle_id String
  payrollCycle     PayrollCycle @relation(fields: [payroll_cycle_id], references: [id], onDelete: Cascade)
  teacher_id       String
  teacher          Teacher      @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  net_salary        Float
  overtime_hours    Float @default(0)
  overtime_amount   Float @default(0)
  advance_deduction Float @default(0)
  payable_amount    Float

  status     PayrollStatus @default(PENDING)
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt

  payments PayrollPayment[]

  @@unique([payroll_cycle_id, teacher_id])
  @@map("teacher_payrolls")
}

model StaffPayroll {
  id               String       @id @default(uuid())
  payroll_cycle_id String
  payrollCycle     PayrollCycle @relation(fields: [payroll_cycle_id], references: [id], onDelete: Cascade)
  staff_id         String
  staff            Staff        @relation(fields: [staff_id], references: [id], onDelete: Cascade)

  net_salary        Float
  overtime_hours    Float @default(0)
  overtime_amount   Float @default(0)
  advance_deduction Float @default(0)
  payable_amount    Float

  status     PayrollStatus @default(PENDING)
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt

  payments PayrollPayment[]

  @@unique([payroll_cycle_id, staff_id])
  @@map("staff_payrolls")
}

model SalaryAdvance {
  id String @id @default(uuid())

  teacher_id String?
  teacher    Teacher? @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  staff_id String?
  staff    Staff?  @relation(fields: [staff_id], references: [id], onDelete: Cascade)

  paid_by_admin_id String?
  paid_by_admin    Administrator? @relation(fields: [paid_by_admin_id], references: [id], onDelete: SetNull)

  advance_amount Float

  reason String? @db.Text

  given_at DateTime

  payment_method PaymentMethod

  transaction_id        String? @unique
  bkash_sender_number   String? @db.VarChar(20)
  bkash_receiver_number String? @db.VarChar(20)
  payment_note          String? @db.Text

  advance_status AdvanceStatus @default(ACTIVE)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("salary_advances")
}

model PayrollPayment {
  id String @id @default(uuid())

  teacher_payroll_id String?
  teacherPayroll     TeacherPayroll? @relation(fields: [teacher_payroll_id], references: [id], onDelete: Cascade)
  staff_payroll_id   String?
  staffPayroll       StaffPayroll?   @relation(fields: [staff_payroll_id], references: [id], onDelete: Cascade)

  payment_method PaymentMethod
  amount         Float

  transaction_id        String? @unique
  bkash_sender_number   String? @db.VarChar(20)
  bkash_receiver_number String? @db.VarChar(20)

  payment_note String? @db.Text

  paid_at          DateTime
  paid_by_admin_id String
  paid_by_admin    Administrator @relation(fields: [paid_by_admin_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("payroll_payments")
}

