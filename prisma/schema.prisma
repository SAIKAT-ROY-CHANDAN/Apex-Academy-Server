  leave_start_date  DateTime
  leave_end_date    DateTime
  leave_type        LeaveType
  leave_application String      @db.Text
  leave_status      LeaveStatus @default(PENDING)
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  @@map("staff_leaves")
}

model StaffOvertime {
  id             String              @id @default(uuid())
  staff_id       String
  staff          Staff               @relation(fields: [staff_id], references: [id], onDelete: Cascade)
  overtime_id    String
