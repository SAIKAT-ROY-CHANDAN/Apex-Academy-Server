  requirements String?              @db.Text
  courseList   String?              @map("course_list") @db.Text
  isActive     Boolean              @default(true) @map("is_active")
  order        Int                  @default(0)

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@map("admission_programs")
}

enum AdmissionProgramType {
  UNDERGRADUATE
  GRADUATE
  HSC
  POST_GRADUATE
}

model WebsiteFaqSection {
  id       String  @id @default(cuid())
  heading  String?
  imageUrl String? @map("image_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("website_faq_sections")
}

model WebsiteFaq {
  id       String  @id @default(cuid())
  question String?
  answer   String? @db.Text

  // Named to match the query builder's default orderBy ({ created_at }).
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("website_faqs")
}

model WebsiteContactUs {
  id           String  @id @default(cuid())
  heading      String?
  subHeading   String? @map("sub_heading")
  phone        String? @db.VarChar(50)
  email        String? @db.VarChar(255)
  location     String? @db.Text
  mapUrl       String? @map("map_url") @db.Text
  workingHours String? @map("working_hours")
  facebookUrl  String? @map("facebook_url") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("website_contact_us")
}

model WebsiteFooterBranding {
  id            String  @id @default(cuid())
  heading       String?
  subHeading    String? @map("sub_heading")
  description   String? @db.Text
  footerImage   String? @map("footer_image")
  brandingImage String? @map("branding_image")
  copyrightText String? @map("copyright_text")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("website_footer_brandings")
}

model WebsitePageCover {
  id       String  @id @default(cuid())
  pageKey  String  @unique @map("page_key") @db.VarChar(50)
  imageUrl String? @map("image_url") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("website_page_covers")
}

model WebsitePrincipal {
  id       String   @id @default(cuid())
  name     String   @db.VarChar(255)
  photoUrl String?  @map("photo_url") @db.Text
  fromDate DateTime @map("from_date") @db.Date
  toDate   DateTime @map("to_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("website_principals")
}

enum AcademicProgramMediaType {
  PHOTO
  VIDEO
}

enum SectionMediaSection {
  ACADEMIC_PROGRAMS
  CO_CURRICULUM_ACTIVITIES
}

model AcademicProgramMedia {
  id          String                   @id @default(cuid())
  section     SectionMediaSection      @default(ACADEMIC_PROGRAMS) @map("section")
  type        AcademicProgramMediaType @map("type")
  title       String                   @map("title") @db.VarChar(255)
  captureDate DateTime                 @map("capture_date") @db.Date
  fileUrl     String?                  @map("file_url") @db.Text
  videoUrl    String?                  @map("video_url") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([section, type])
  @@map("academic_program_media")
}

enum NoticeType {
  UPDATE_NEWS
  GENERAL_NOTICE
  ADMISSION_NOTICE
  IMPROVEMENT_NOTICE
  HSC_NOTICE
  HONOURS_NOTICE
  MASTER_NOTICE
}

model AcademicNotice {
  id         String     @id @default(uuid())
  title      String
  noticeType NoticeType @map("notice_type")
  pdfUrl     String?    @map("pdf_url")
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  @@map("academic_notices")
}

model AcademicSyllabus {
  id          String   @id @default(uuid())
  title       String
  syllabusUrl String?  @map("syllabus_url")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("academic_syllabuses")
}

model AcademicTuition {
  id            String   @id @default(uuid())
  title         String
  tuitionUrl    String?  @map("tuition_url")
  tuitionAmount Float?   @map("tuition_amount")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("academic_tuitions")
}

enum AcademicTuitionType {
  CAMPUS
  SCHOLARSHIP
  LIBRARY
  STUDENT_CLUB
}

model AcademicFacilities {
  id                String              @id @default(uuid())
  name              String
  main_image_url    String?             @map("main_image_url") @db.Text
  facilities_type   AcademicTuitionType @default(CAMPUS)
  sub_one_image_url String?             @map("sub_one_image_url") @db.Text
  sub_two_image_url String?             @map("sub_two_image_url") @db.Text
  description       String?             @db.Text
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt

  @@map("academic_facilities")
}


// BKASH PAYMENT SESSIONS - Tracks initiated tokenized gateway transactions to prevent IDOR & double execution
model BkashPaymentSession {
  id           String   @id @default(uuid())
  payment_id   String   @unique @db.VarChar(100)
  student_id   String?  @db.VarChar(100)
  payment_type String   @db.VarChar(50)
  target_id    String?  @db.VarChar(100)
  amount       Float
  status       String   @default("INITIATED") @db.VarChar(50)
  trx_id       String?  @db.VarChar(100)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([payment_id])
  @@index([student_id])
  @@map("bkash_payment_sessions")
}
