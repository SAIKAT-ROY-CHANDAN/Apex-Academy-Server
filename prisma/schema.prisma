// QUARTER ALLOCATION
model QuarterAllocation {
  id                     String                  @id @default(uuid())
  teacher_id             String?
  teacher                Teacher?                @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  staff_id               String?
